{
  "dataset": {
    "aria_root_base": "/home/ycl/projects/datasets",
    "dataset_dir": "/home/ycl/projects/workspace/spider/example_datasets",
    "dataset_name": "aria",
    "robot_type": "xhand",
    "embodiment_type": "right",
    "active_hand": "right",
    "roots": {
      "mustard": "mustard/data",
      "drawer": "drawer/data",
      "flower": "flower/data",
      "hammer": "hammer/data"
    }
  },
  "run": {
    "mode": "batch",
    "tasks": ["mustard", "drawer", "flower", "hammer"],
    "python_bin": "python",
    "device_env": "REPLAY_DEVICE",
    "default_device": "cuda:0",
    "show_viewer": false,
    "viewer_backend": "mujoco",
    "save_video": true,
    "video_dir": "outputs/aria_replay_videos",
    "early_termination": true
  },
  "timing": {
    "sim_dt": 0.01,
    "ctrl_dt": 0.05,
    "horizon": 1.6,
    "knot_dt": 0.4
  },
  "reward": {
    "pos_rew_scale": 1.0,
    "rot_rew_scale": 0.3,
    "joint_rew_scale": 0.0,
    "base_pos_rew_scale": 0.0,
    "base_rot_rew_scale": 0.0,
    "vel_rew_scale": 0.0,
    "contact_rew_scale": 0.0,
    "object_pos_threshold": 0.05,
    "object_rot_threshold": 1,
    "object_mass_scale": 0.1
  },
  "task_overrides": {
    "mustard": {
      "object_rot_threshold": 1.5,
      "contact_rew_scale": 0.0,
      "joint_rew_scale": 0.0
    },
    "drawer": {
      "object_rot_threshold": 1.5,
      "contact_rew_scale": 0.0,
      "joint_rew_scale": 0.0
    },
    "flower": {
      "object_rot_threshold": 1.5,
      "contact_rew_scale": 0.0,
      "joint_rew_scale": 0.0
    },
    "hammer": {
      "early_termination": true,
      "object_rot_threshold": 1.5,
      "contact_rew_scale": 0.0,
      "joint_rew_scale": 0.0
    }
  }
}
